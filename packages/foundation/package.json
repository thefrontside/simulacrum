{
  "name": "@simulacrum/foundation-simulator",
  "version": "0.8.0",
  "description": "Base simulator to build simulators for integration testing.",
  "keywords": [
    "emulation",
    "integration testing",
    "mock",
    "mocking",
    "simulation"
  ],
  "bugs": {
    "url": "https://github.com/thefrontside/simulacrum/issues"
  },
  "license": "MIT",
  "author": "Frontside Engineering <engineering@frontside.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thefrontside/simulacrum.git",
    "directory": "packages/foundation"
  },
  "files": [
    "README.md",
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "bench": "vitest bench",
    "build": "tsdown",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "start": "node --experimental-transform-types ./example/singleFileServer/start.ts",
    "start:extensive": "node --experimental-transform-types ./example/extensiveServer/start.ts",
    "start:pingback": "node --experimental-transform-types ./example/pingback/start.ts",
    "start:pingback:watch": "node --experimental-transform-types --watch-path=./example/pingback ./example/pingback/start.ts",
    "start:simple": "node --experimental-transform-types ./example/simpleStart/index.ts",
    "start:singlefile": "node --experimental-transform-types ./example/singleFileServer/start.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "defu": "^6.1.7",
    "express": "^5.2.1",
    "fdir": "^6.5.0",
    "http-proxy-middleware": "^3.0.5",
    "openapi-backend": "^5.17.0",
    "starfx": "^0.16.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3"
  }
}
